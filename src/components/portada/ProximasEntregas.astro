---
// Las próximas fechas de ambos ensayos, intercaladas: el diálogo de los dos ritmos.
import { proximasEntregas, diaTexto } from '../../lib/calendario.js';
const proximas = proximasEntregas(4);
const nombre = { luz: 'La luz', escritura: 'Lo que se pierde al escribir' };
---
{proximas.length > 0 && (
  <section class="prox" aria-labelledby="prox-titulo">
    <div class="wrap prox-grid">
      <div class="prox-cabecera">
        <h2 id="prox-titulo" class="prox-titulo">Próximas entregas</h2>
        <p>La luz, cada miércoles. Lo que se pierde al escribir, un domingo sí y uno no.</p>
        <a href="/ensayos/">Calendario de lectura →</a>
      </div>
      <ol class="prox-lista">
        {proximas.map((e) => (
          <li class={`prox-${e.serie}`}>
            <span class="prox-dia">{diaTexto(e.fecha)}</span>
            <span class="prox-serie">{nombre[e.serie]}</span>
            <span class="prox-entrega">Entrega {e.entrega}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
