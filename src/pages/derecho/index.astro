---
import Base from '../../layouts/Base.astro';
import { articulosDerecho, fechaTexto } from '../../lib/contenido.js';

const articulos = await articulosDerecho();
---

<Base title="Norma y Proceso" description="Derecho tributario y cumplimiento: dónde la norma se rompe al llevarla a la práctica." seccion="seccion-papel">
  <section class="cabecera-seccion">
    <p class="etiqueta">Norma y Proceso</p>
    <h1>La norma no se cumple con criterio. Se cumple con proceso.</h1>
    <p>
      Notas sobre derecho tributario, cumplimiento y los lugares donde la teoría
      se rompe al llevarla a volumen.
    </p>
  </section>

  <ul class="lista">
    {articulos.map((a) => (
      <li>
        {a.data.imagen && <a href={`/derecho/${a.id}/`}><img class="lista-img" src={a.data.imagen.replace(/\.png$/, '.svg')} alt="" width="1200" height="630" loading="lazy" /></a>}
        <p class="etiqueta">{a.data.tema}{a.data.borrador && ' · borrador'}</p>
        <h2><a href={`/derecho/${a.id}/`}>{a.data.titulo}</a></h2>
        <p>{a.data.bajada}</p>
        <p class="meta">{fechaTexto(a.data.fecha)}{a.data.lectura && ` · ${a.data.lectura} de lectura`}</p>
        <a class="leer" href={`/derecho/${a.id}/`}>Leer el artículo completo →</a>
      </li>
    ))}
  </ul>
  {articulos.length === 0 && <p class="vacio">El primer artículo se publicará pronto.</p>}
</Base>
