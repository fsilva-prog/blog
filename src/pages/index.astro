---
import Base from '../layouts/Base.astro';
import Redes from '../components/Redes.astro';
import {
  articulosDerecho, entregasEnsayo, fechaTexto, TOTAL_ENTREGAS,
} from '../lib/contenido.js';

const derecho = await articulosDerecho();
const entregas = await entregasEnsayo();
const ultima = entregas.at(-1);
const imagenLuz = ultima?.data.imagen?.replace(/\.png$/, '.svg');
---

<Base seccion="seccion-inicio" lateral={false}>
  <section class="presentacion con-foto">
    <img class="foto-autor" src="/img/felipe.jpg" alt="Felipe Silva Landeros" width="720" height="720" />
    <div class="presentacion-texto">
    <p class="etiqueta">Abogado · Docente universitario · Puerto Montt</p>
    <h1>Felipe Silva Landeros</h1>
    <p>
      Escribo sobre derecho societario y tributario para pymes y emprendedores,
      desde lo que veo en la práctica, y sobre las preguntas que deja abiertas la ciencia
      cuando se la mira junto al símbolo.
    </p>
    <div class="acciones-inicio">
      <a class="mas-sobre-mi" href="/acerca/">Más sobre mí →</a>
      <a class="boton-contacto" href="/acerca/#contacto">Escríbeme</a>
    </div>
    <Redes />
    </div>
  </section>

  <div class="caminos">
    <a class="camino camino-luz" href="/la-luz/">
      <span class="camino-texto">
        <span class="etiqueta">Libro en curso</span>
        <span class="camino-titulo">La luz, guardián del universo</span>
        <span class="camino-bajada">
          La luz como límite, archivo y mensajera del universo, entre la física y el símbolo.
        </span>
        <span class="camino-meta">
          {ultima
            ? <>Entrega {ultima.data.entrega} de {TOTAL_ENTREGAS}: {ultima.data.titulo}</>
            : <>Primera entrega próximamente</>}
        </span>
      </span>
      {imagenLuz && <img class="camino-img" src={imagenLuz} alt="" width="1200" height="630" />}
    </a>

    <a class="camino camino-papel" href="/derecho/">
      <span class="etiqueta">Norma y Proceso</span>
      <span class="camino-titulo">La norma no se cumple con criterio. Se cumple con proceso.</span>
      <span class="camino-bajada">Derecho societario y tributario para pymes y emprendedores, en el punto donde la teoría se encuentra con la práctica.</span>
      <span class="camino-meta">
        {derecho.length
          ? <>Último: {derecho[0].data.titulo} · {fechaTexto(derecho[0].data.fecha)}</>
          : <>Primer artículo próximamente</>}
      </span>
    </a>

  </div>

  <section class="banda-proyecto" aria-labelledby="proyecto-titulo">
    <a class="banda-marca" href="https://www.simplificalo.cl" rel="noopener">
      <img src="/img/simplificalo.png" alt="Simplificalo, soluciones legales y tributarias" width="900" height="252" />
    </a>
    <div class="banda-texto">
      <p class="etiqueta">Emprendimiento</p>
      <h2 id="proyecto-titulo">Simplificalo, mi primer proyecto</h2>
      <p>
        Fundé Simplificalo, una plataforma chilena que automatiza la contabilidad y el
        cumplimiento tributario de pequeñas y medianas empresas: declaraciones,
        facturación, conciliación bancaria y un portal propio para cada cliente.
        Muchas de las ideas de Norma y Proceso nacen ahí, de ver qué ocurre cuando una
        norma se aplica doscientas veces al mes.
      </p>
      <a class="banda-enlace" href="https://www.simplificalo.cl" rel="noopener">Visitar simplificalo.cl →</a>
    </div>
  </section>
</Base>
