---
// Portada. Dos mundos en diálogo: primero el derecho, sobre papel; luego,
// tras un umbral que oscurece, los dos ensayos con su propia noche y su arcilla.
import Base from '../layouts/Base.astro';
import Presentacion from '../components/portada/Presentacion.astro';
import CapituloDerecho from '../components/portada/CapituloDerecho.astro';
import EnsayoBanda from '../components/portada/EnsayoBanda.astro';
import ProximasEntregas from '../components/portada/ProximasEntregas.astro';
import {
  articulosDerecho, textosCatedra, entregasEnsayo, entregasEscritura,
  TOTAL_ENTREGAS, TOTAL_ESCRITURA,
} from '../lib/contenido.js';
import { proximaDe } from '../lib/calendario.js';
import '../styles/portada.css';

const derecho = await articulosDerecho();
const catedra = await textosCatedra();
const luz = await entregasEnsayo();
const escritura = await entregasEscritura();
---

<Base seccion="seccion-inicio" completo>
  <Presentacion />
  <CapituloDerecho articulos={derecho} catedra={catedra} />

  <div class="mundos">
    <header class="umbral">
      <div class="wrap umbral-interior">
        <span class="cap-numero" aria-hidden="true">II</span>
        <div>
          <p class="cap-etiqueta">Los ensayos</p>
          <h2 class="umbral-titulo">Lo que escribo cuando cierro el expediente</h2>
          <p class="umbral-texto">
            Dos ensayos por entregas, cada uno con su ritmo y su propio mundo: uno mira la luz
            entre la física y el símbolo; el otro, lo que perdemos cada vez que el saber cambia de soporte.
          </p>
        </div>
      </div>
    </header>

    <EnsayoBanda
      mundo="luz"
      href="/la-luz/"
      titulo="La luz, guardián del universo"
      descripcion="La luz como límite, archivo y mensajera del universo, entre la física y el símbolo."
      ritmo="cada miércoles"
      entregas={luz}
      total={TOTAL_ENTREGAS}
      proxima={proximaDe('luz')}
      imagenPorDefecto="/img/entregas/01-el-guardian.svg"
    />

    <EnsayoBanda
      mundo="escritura"
      href="/escritura/"
      titulo="Lo que se pierde al escribir"
      descripcion="La escritura, la memoria y lo que cambia cada vez que el saber cambia de soporte, hasta la inteligencia artificial."
      ritmo="un domingo sí y uno no"
      entregas={escritura}
      total={TOTAL_ESCRITURA}
      proxima={proximaDe('escritura')}
      imagenPorDefecto="/img/escritura/01-volver-a-la-voz.svg"
      invertida
    />
  </div>

  <ProximasEntregas />
</Base>
